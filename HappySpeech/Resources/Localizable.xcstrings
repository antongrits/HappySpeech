    "acousticMirror.entry.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверь, куда летит твой звук — к С или к Ш"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where your sound lands — closer to S or Sh"
          }
        }
      }
    },
    "acousticMirror.entry.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акустическое зеркало"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acoustic Mirror"
          }
        }
      }
    },
    "acousticMirror.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось записать звук. Попробуй ещё раз!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't record the sound. Try again!"
          }
        }
      }
    },
    "acousticMirror.error.micPermission": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы зеркало услышало звук, нужен доступ к микрофону."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mirror needs microphone access to hear your sound."
          }
        }
      }
    },
    "acousticMirror.gauge.empty.a11y": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шкала от Ш до С. Звук ещё не записан."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scale from Sh to S. No sound recorded yet."
          }
        }
      }
    },
    "acousticMirror.gauge.position.a11y": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой звук на %d процентах пути от Ш к С."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sound is at %d percent of the way from Sh to S."
          }
        }
      }
    },
    "acousticMirror.hint.airstream": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подуй посильнее — пусть ветерок будет слышен!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blow a bit stronger — let the airflow be heard!"
          }
        }
      }
    },
    "acousticMirror.hint.focus": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук получился размытым. Поставь язычок поточнее и попробуй снова."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound was a bit fuzzy. Place your tongue more precisely and try again."
          }
        }
      }
    },
    "acousticMirror.hint.longer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошо! А теперь потяни звук ещё дольше."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice! Now stretch the sound even longer."
          }
        }
      }
    },
    "acousticMirror.hint.sustain": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяни звук подольше, на всём выдохе: не меньше двух секунд."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stretch the sound longer, on one breath — at least two seconds."
          }
        }
      }
    },
    "acousticMirror.hint.towardHissing": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделай губы трубочкой, язычок чашечкой вверх — звук станет шире, как Ш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Round your lips, cup your tongue up — the sound will get wider, like Sh."
          }
        }
      }
    },
    "acousticMirror.hint.towardWhistling": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улыбнись шире, кончик язычка вниз — и звук станет тоньше, как С."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smile wider, tongue tip down — the sound will get thinner, like S."
          }
        }
      }
    },
    "acousticMirror.instruction": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на микрофон и потяни звук: %@-%@-%@!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the mic and stretch the sound: %@-%@-%@!"
          }
        }
      }
    },
    "acousticMirror.pole.hissing": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шипящий звук — тёплый и широкий, как змейка: ш-ш-ш"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hissing sound — warm and wide, like a snake: sh-sh-sh"
          }
        }
      }
    },
    "acousticMirror.pole.s.label": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "S"
          }
        }
      }
    },
    "acousticMirror.pole.sh.label": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ш"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sh"
          }
        }
      }
    },
    "acousticMirror.pole.whistling": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свистящий звук — тонкий и высокий, как насос: с-с-с"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A whistling sound — thin and high, like a pump: s-s-s"
          }
        }
      }
    },
    "acousticMirror.progress.a11y": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раунд %d из %d"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Round %d of %d"
          }
        }
      }
    },
    "acousticMirror.result.middle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой звук пока между С и Ш — посмотри на шарик!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sound is between S and Sh — look at the ball!"
          }
        }
      }
    },
    "acousticMirror.result.nearTarget": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти получилось — шарик совсем рядом с целью!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost there — the ball is right next to the target!"
          }
        }
      }
    },
    "acousticMirror.result.noSound": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я не расслышала звук — попробуем ещё разок?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't hear the sound — shall we try again?"
          }
        }
      }
    },
    "acousticMirror.result.onTarget": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В яблочко! Звук там, где нужно!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bullseye! Your sound is right on target!"
          }
        }
      }
    },
    "acousticMirror.result.sweptToHissing": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ой, звук убежал к Ш! Улыбнись шире и попробуй ещё."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oops, the sound ran off to Sh! Smile wider and try again."
          }
        }
