    "acousticMirror.complete.keepGoing": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошая тренировка! Завтра шарик подберётся ещё ближе."
