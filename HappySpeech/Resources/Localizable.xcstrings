    "acousticMirror.complete.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зеркало запомнило, как звучит твой звук «%@». Возвращайся потренироваться!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mirror remembered how your “%@” sounds. Come back to practice!"
          }
        }
      }
    },
