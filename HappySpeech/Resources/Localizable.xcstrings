    "helpCenter.video.edu_breath.description": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длинный плавный выдох уносит пушинки."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One long smooth exhale carries the seeds away."
          }
        }
      }
    },
