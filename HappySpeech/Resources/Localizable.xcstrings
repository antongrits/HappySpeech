    "inspiration.q1.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая буква, которую малыш произнёс правильно, — это маленькая победа."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every letter the child pronounces correctly is a small victory."
          }
        }
      }
    },
    "inspiration.q10.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушайте ребёнка с интересом — это лучшая мотивация говорить."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen to your child with interest — it is the best motivation to speak."
          }
        }
      }
    },
    "inspiration.q2.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дети говорят так же, как с ними говорят родители. Будьте образцом."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Children speak the way their parents speak to them. Be the model."
          }
        }
      }
    },
    "inspiration.q3.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терпение и ежедневная практика побеждают любой звук."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patience and daily practice conquer any sound."
          }
        }
      }
    },
    "inspiration.q4.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Артикуляционная гимнастика — это фундамент чистой речи."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Articulation exercises are the foundation of clear speech."
          }
        }
      }
    },
    "inspiration.q5.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ребёнок учится через игру — превратите занятие в приключение."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A child learns through play — turn the lesson into an adventure."
          }
        }
      }
    },
    "inspiration.q6.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвалите за усилия, а не только за результат."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Praise the effort, not just the result."
          }
        }
      }
    },
    "inspiration.q7.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткие ежедневные занятия лучше долгих и редких."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short daily sessions beat long, rare ones."
          }
        }
      }
    },
    "inspiration.q8.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите медленно и чётко — ребёнок учится, подражая вам."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak slowly and clearly — the child learns by imitating you."
          }
        }
      }
    },
    "inspiration.q9.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Развитие мелкой моторики помогает развитию речи."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developing fine motor skills supports speech development."
          }
        }
      }
    },
