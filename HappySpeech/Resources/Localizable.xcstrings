          "stringUnit": {
            "state": "translated",
            "value": "Снижает визуальную и звуковую стимуляцию в детском режиме"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduces visual and audio stimulation in the kids mode"
          }
        }
      }
    },
    "settings.calmMode.footer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогает детям, чувствительным к ярким анимациям и звукам: фон становится спокойнее, награды появляются мягко, без взрывов конфетти. Можно включить или выключить в любой момент."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps children who are sensitive to bright animations and sounds: the background becomes calmer and rewards appear gently, without confetti bursts. You can turn it on or off at any time."
          }
        }
      }
    },
