    "articulation3d.pose.k": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задняя часть спинки языка смыкается с мягким нёбом."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The back of the tongue closes against the soft palate."
          }
        }
      }
    },
    "articulation3d.pose.kh": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задняя часть спинки образует щель с мягким нёбом — воздух проходит со звуком."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The back of the tongue forms a gap with the soft palate — air passes through with friction."
          }
        }
      }
    },
    "articulation3d.pose.l": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кончик упирается в верхние резцы, спинка прогнута седлом — воздух идёт по бокам."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tip presses the upper incisors, the body dips like a saddle — air flows along the sides."
          }
        }
      }
    },
    "articulation3d.pose.neutral": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык в спокойном положении."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tongue at rest."
          }
        }
      }
    },
    "articulation3d.pose.r": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кончик языка «ложечкой» поднят к альвеолам и вибрирует, края прижаты к коренным зубам."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A spoon-shaped tip rises to the alveolar ridge and vibrates, the edges press the molars."
          }
        }
      }
    },
    "articulation3d.pose.s": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кончик языка у нижних зубов, спинка приподнята горкой с желобком — узкая холодная струя по центру."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tongue tip at the lower teeth, the front arches with a groove — a narrow cool airstream down the centre."
          }
        }
      }
    },
    "articulation3d.pose.sh": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Широкий кончик «чашечкой» к альвеолам, спинка двугорбая — тёплая широкая струя."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wide cup-shaped tip rises to the alveolar ridge, the back is double-humped — a warm broad airstream."
          }
        }
      }
    },
