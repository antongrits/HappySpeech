    "slug": "sad_ya_veryu_v_tebya",
    "path": "Lyalya/Phrases/sad/sad_ya_veryu_v_tebya.m4a"
  },
  {
    "phraseId": "sad_vsem_byvaet_trudno",
    "ru_text": "Всем бывает трудно — главное не останавливаться.",
