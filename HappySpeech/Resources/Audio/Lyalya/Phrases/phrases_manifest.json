    "slug": "sad_zdes_mnogo_delayu",
    "path": "Lyalya/Phrases/sad/sad_zdes_mnogo_delayu.m4a"
  },
  {
    "phraseId": "sad_ochen_pochti",
    "ru_text": "Очень-очень близко! Ещё чуть-чуть.",
