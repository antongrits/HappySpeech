    "slug": "sad_otdohni_i_snova",
    "path": "Lyalya/Phrases/sad/sad_otdohni_i_snova.m4a"
  },
  {
    "phraseId": "sad_zdes_mnogo_delayu",
    "ru_text": "Здесь нужно постараться — и у тебя выйдет!",
