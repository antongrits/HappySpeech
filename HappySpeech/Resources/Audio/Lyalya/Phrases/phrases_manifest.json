  },
  {
    "phraseId": "sad_eto_trudny_zvuk",
    "ru_text": "Это трудный звук, и это нормально.",
    "emotion": "sad",
    "slug": "sad_eto_trudny_zvuk",
    "path": "Lyalya/Phrases/sad/sad_eto_trudny_zvuk.m4a"
  },
  {
    "phraseId": "sad_ne_rasstraivaysya",
    "ru_text": "Не расстраивайся, у тебя обязательно получится.",
