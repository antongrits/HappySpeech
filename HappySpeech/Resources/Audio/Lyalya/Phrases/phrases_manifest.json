    "slug": "sad_vsem_byvaet_trudno",
    "path": "Lyalya/Phrases/sad/sad_vsem_byvaet_trudno.m4a"
  },
  {
    "phraseId": "sad_otdohni_i_snova",
    "ru_text": "Может, чуть отдохнём и попробуем снова?",
