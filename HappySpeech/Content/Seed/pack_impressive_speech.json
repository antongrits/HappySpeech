        { "id": "t1-myach",  "minAge": 5, "instruction": "Покажи мяч",      "correct": "soccerball",         "distractors": ["car.fill", "leaf.fill", "house.fill"], "labels": {"soccerball": "мяч", "car.fill": "машина", "leaf.fill": "лист", "house.fill": "дом"} },
        { "id": "t1-koshka", "minAge": 5, "instruction": "Покажи кошку",     "correct": "cat.fill",           "distractors": ["pawprint.fill", "bird.fill", "ant.fill"], "labels": {"cat.fill": "кошка", "pawprint.fill": "лапа", "bird.fill": "птица", "ant.fill": "муравей"} },
        { "id": "t1-yabloko","minAge": 5, "instruction": "Покажи яблоко",    "correct": "apple.logo",         "distractors": ["leaf.fill", "drop.fill", "flame.fill"], "labels": {"apple.logo": "яблоко", "leaf.fill": "лист", "drop.fill": "капля", "flame.fill": "огонь"} },
        { "id": "t1-solnce", "minAge": 5, "instruction": "Покажи солнце",    "correct": "sun.max.fill",       "distractors": ["moon.fill", "cloud.fill", "snowflake"], "labels": {"sun.max.fill": "солнце", "moon.fill": "луна", "cloud.fill": "облако", "snowflake": "снежинка"} },
        { "id": "t1-zvezda", "minAge": 5, "instruction": "Покажи звезду",    "correct": "star.fill",          "distractors": ["heart.fill", "circle.fill", "square.fill"], "labels": {"star.fill": "звезда", "heart.fill": "сердце", "circle.fill": "круг", "square.fill": "квадрат"} },
        { "id": "t1-kniga",  "minAge": 5, "instruction": "Покажи книгу",     "correct": "book.fill",          "distractors": ["pencil", "scissors", "paintbrush.fill"], "labels": {"book.fill": "книга", "pencil": "карандаш", "scissors": "ножницы", "paintbrush.fill": "кисть"} },
        { "id": "t1-mashina","minAge": 5, "instruction": "Покажи машину",    "correct": "car.fill",           "distractors": ["bicycle", "airplane", "tram.fill"], "labels": {"car.fill": "машина", "bicycle": "велосипед", "airplane": "самолёт", "tram.fill": "трамвай"} },
